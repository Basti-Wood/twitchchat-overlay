FROM node:22-alpine

WORKDIR /app

COPY conf/accounts.json ./conf/
COPY conf/config.json ./conf/
COPY css/ ./css/
COPY src/ ./src/
COPY html/ ./html/
COPY uploads/ ./uploads/
COPY index.html ./
COPY server.js ./

# NOTE: .env is intentionally NOT copied into the image (it holds secrets).
# Provide the environment at runtime via docker-compose `env_file: .env`
# (see docker-compose.yaml) or `docker run --env-file .env`.

EXPOSE 8080

CMD ["node", "server.js"]
