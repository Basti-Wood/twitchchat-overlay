FROM node:22-alpine

WORKDIR /app

COPY css/ ./css/
COPY src/ ./src/
COPY html/ ./html/
COPY index.html ./
COPY server.js ./

# NOTE: .env is intentionally NOT copied into the image (it holds secrets).
# Provide the environment at runtime via docker-compose `env_file: .env`
# (see docker-compose.yaml) or `docker run --env-file .env`.

# User data is NOT stored in the image: docker-compose bind-mounts a host folder to /data.
ENV DATA_DIR=/data

EXPOSE 8080

CMD ["node", "server.js"]
