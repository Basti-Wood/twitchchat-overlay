# ─────────────────────────────────────────────────────────────────────────────
#  Environment for the Twitch Chat Overlay TTS feature
#  Copy this file to ".env" (same folder as server.js) and fill in the values.
#  The .env file is git-ignored — never commit your real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── ElevenLabs ──
# Get your API key from https://elevenlabs.io/ → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Twitch application (for EventSub: bits, resubs, channel point redeems) ──
# Create an app at https://dev.twitch.tv/console/apps
#   • OAuth Redirect URL must EXACTLY match TWITCH_REDIRECT_URI below
#   • Category: "Chat Bot" (or anything), Client Type: Confidential
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret

# Where Twitch sends the streamer back after authorizing. Must be registered
# in the Twitch dev console as an OAuth Redirect URL, character-for-character.
#   • Local testing:  http://localhost:8080/api/tts/oauth/callback
#   • Production:      https://your-domain.example.com/api/tts/oauth/callback
TWITCH_REDIRECT_URI=http://localhost:8080/api/tts/oauth/callback

# ── Server ──
PORT=8080

# ── Website login (Twitch) ───────────────────────────────────────────────────
# The SAME Twitch app is used for the login. Add a SECOND OAuth Redirect URL to it:
#   • Local testing:  http://localhost:8080/auth/twitch/callback
#   • Production:      https://your-domain.example.com/auth/twitch/callback
# The login redirect is derived from PUBLIC_URL (preferred) or, if that is empty,
# from TWITCH_REDIRECT_URI above (its /api/tts/oauth/callback is swapped for
# /auth/twitch/callback). Set TWITCH_LOGIN_REDIRECT_URI to override completely.
PUBLIC_URL=http://localhost:8080
#TWITCH_LOGIN_REDIRECT_URI=

# Twitch login name(s) that are ALWAYS administrators (comma separated).
# They are approved automatically on login and can approve everybody else
# on /html/admin.html. Required for the first start.
ADMIN_TWITCH_LOGINS=your_twitch_login

# Where ALL user data lives (uploads, saved configs, users, tokens, TTS audio).
# Keep this folder when updating the app. Default: ./data  (Docker: /data)
#DATA_DIR=./data

# Docker only: host folder that stores all user data (survives deleting the container/image).
# Use an absolute path outside the project if you like. Default: ./data
#DATA_PATH=D:/overlay-data
